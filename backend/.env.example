# Environment Variables Configuration
PROJECT_NAME="Skill Assessment Platform API"
API_V1_STR="/api/v1"

# Database: SQLite for development, or PostgreSQL for production
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skill_assessment
DATABASE_URL=sqlite:///./app.db

# Security & JWT
JWT_SECRET_KEY="super-secret-key-change-this-in-production-use-openssl-rand-hex-32"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS: Specific allowed origins separated by commas
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://103.75.182.246"

# Redis & Celery
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Media Storage & Upload Constraints
MAX_UPLOAD_SIZE_MB=150
ALLOWED_EXTENSIONS=".mp4,.avi,.mov,.mkv,.webm"
UPLOAD_DIR="storage/uploads"
OUTPUT_DIR="storage/outputs"
COACH_SAMPLES_DIR="storage/coach_samples"
POSE_CACHE_DIR="storage/pose_cache"

# AI Pipeline (xem giải thích ở ../.env.example)
AI_ESTIMATOR_TYPE="precomputed,remote,yolo,mock"
AI_REMOTE_URL=""
AI_SCORER_TYPE="pa_mpjpe_dtw"
MIN_VIDEO_SECONDS=10
MAX_WORDS=500

# Firebase (tùy chọn)
FIREBASE_CREDENTIALS=""
FIREBASE_DB_URL=""
