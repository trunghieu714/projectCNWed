# ==============================================================================
# SKILL ASSESSMENT PLATFORM - ENVIRONMENT CONFIGURATION
# BTL Công nghệ Web (IT4409) - HUST SOICT
# Sao chép thành backend/.env rồi chỉnh theo máy của bạn.
# ==============================================================================

# 1. Cơ sở dữ liệu (SQLite cho local hoặc PostgreSQL)
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/skill_db

# 2. Redis & Celery (không có Redis thì bài nộp được chấm đồng bộ)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# 3. Bảo mật & Xác thực JWT (có thể đặt tên JWT_SECRET_KEY hoặc SECRET_KEY)
SECRET_KEY=change_me_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 5. AI Pipeline
# Chuỗi estimator thử lần lượt (dừng ở estimator đầu tiên thành công):
#   precomputed : đọc pose 3D có sẵn cạnh video (abc.pkl / abc.pt / abc.npz / abc.json) do WHAM/GVHMR xuất ra
#   remote      : gửi video tới server GPU/Colab (AI_REMOTE_URL), xem ai_engine/remote_server/pose_server.py
#   yolo        : YOLO pose 2D trên máy local (pip install ultralytics)
#   mock        : pose giả lập tất định - CHỈ dùng khi demo không có GPU
AI_ESTIMATOR_TYPE=precomputed,remote,yolo,mock
AI_REMOTE_URL=
YOLO_POSE_WEIGHTS=yolo26x-pose.pt
# File hiệu chỉnh 2 camera để fusion pose 2D -> 3D (Slide 10), dạng {"P1": 3x4, "P2": 3x4}
AI_CAMERA_CALIB_PATH=
# pa_mpjpe_dtw (theo code mẫu của GV) | dtw (5 góc khớp)
AI_SCORER_TYPE=pa_mpjpe_dtw
AI_VISUALIZER_TYPE=fused_video
DTW_WINDOW_RATIO=0.1
SCORE_ERROR_TOLERANCE=0.12
SCORE_MAX_ERROR=0.45

# 6. Ràng buộc nội dung (Slide 24-25)
MIN_VIDEO_SECONDS=10
MAX_WORDS=500
MAX_UPLOAD_SIZE_MB=150
FFMPEG_BINARY=ffmpeg

# 7. Firebase (push notification + báo bài nộp mới cho Local Host) - tùy chọn
FIREBASE_CREDENTIALS=
FIREBASE_DB_URL=

# 8. Frontend (Next.js) - đặt trong frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
